package views

import (
	"fmt"
	"time"

	"github.com/your-org/rconman/internal/auth"
	"github.com/your-org/rconman/internal/config"
	"github.com/your-org/rconman/internal/store"
)

templ HomePage(session *auth.Session, servers []config.ServerDef) {
	@Layout(session) {
		if len(servers) == 0 {
			<div class="card card-modern p-8 text-center">
				<p class="text-gray-400">No servers configured.</p>
			</div>
		} else {
			<div>
				<script>window.selectedServer = { fmt.Sprintf("%q", servers[0].ID) };</script>
				<div id="server-selector"
					hx-get="/partials/selector"
					hx-trigger="load, every 10s"
					hx-vals='js:{selected: window.selectedServer}'
					hx-swap="innerHTML"
				>
					<div class="flex items-center gap-2 text-gray-400 text-sm py-2">
						<span class="loading loading-dots loading-sm"></span>
					</div>
				</div>
				<div id="server-content" hx-get={ fmt.Sprintf("/partials/server/%s", servers[0].ID) } hx-trigger="load" hx-swap="innerHTML">
					<div class="flex items-center justify-center py-12">
						<span class="loading loading-dots loading-md text-blue-400"></span>
					</div>
				</div>
				<div class="collapse collapse-arrow bg-base-200 bg-opacity-50 border border-base-300 mt-8">
					<input type="checkbox" name="log-drawer"/>
					<div class="collapse-title font-medium text-gray-300 flex items-center gap-2">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 011-1h2a1 1 0 011 1v10a1 1 0 01-1 1h-2a1 1 0 01-1-1V9z"/></svg>
						Command Log
					</div>
					<div class="collapse-content" hx-get="/partials/logs" hx-trigger="load" hx-swap="innerHTML">
					</div>
				</div>
			</div>
		}
	}
}

func dotClass(online bool) string {
	if online {
		return "bg-green-400"
	}
	return "bg-red-400"
}

func serverName(servers []config.ServerDef, id string) string {
	for _, s := range servers {
		if s.ID == id {
			return s.Name
		}
	}
	return ""
}

templ ServerSelectorPartial(selectedServerID string, servers []config.ServerDef, statuses map[string]bool) {
	<div class="flex items-center gap-4 mb-6">
		<div class="dropdown">
			<div tabindex="0" role="button" class="btn btn-sm border border-base-300 gap-2 w-56 justify-start">
				<span class={ fmt.Sprintf("w-2 h-2 rounded-full %s", dotClass(statuses[selectedServerID])) }></span>
				<span>{ serverName(servers, selectedServerID) }</span>
				<svg class="w-3 h-3 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
			</div>
			<ul class="dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-lg border border-base-300">
				for _, server := range servers {
					<li>
						<button
							data-sel-server-id={ server.ID }
							hx-get={ fmt.Sprintf("/partials/server/%s", server.ID) }
							hx-target="#server-content"
							hx-swap="innerHTML"
							onclick="window.selectedServer=this.dataset.selServerId; htmx.ajax('GET', '/partials/selector?selected=' + this.dataset.selServerId, { target: '#server-selector', swap: 'innerHTML' })"
							class="flex items-center gap-2 w-full"
						>
							<span class={ fmt.Sprintf("w-2 h-2 rounded-full %s", dotClass(statuses[server.ID])) }></span>
							<span>{ server.Name }</span>
						</button>
					</li>
				}
			</ul>
		</div>
	</div>
}

func tabClass(active bool) string {
	if active {
		return "btn btn-sm border border-blue-400 bg-blue-500 bg-opacity-20 text-blue-300"
	}
	return "btn btn-sm border border-base-300 hover:border-blue-400 transition-colors"
}

func templateIDStr(t *store.StoredTemplate) string {
	if t != nil {
		return fmt.Sprintf("%d", t.ID)
	}
	return ""
}

func templateParamsJSON(t *store.StoredTemplate) string {
	if t != nil && t.Params != "" {
		return t.Params
	}
	return "[]"
}

templ ServerPartial(session *auth.Session, server config.ServerDef, lists map[string][]string) {
	<div id="server-content-inner">
		<div class="flex items-center justify-between gap-4 mb-6">
			<div>
				<h1 class="text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
					{ server.Name }
				</h1>
				<p class="text-gray-400 text-sm">{ fmt.Sprintf("%s:%d", server.RCON.Host, server.RCON.Port) }</p>
			</div>
			if session.Role == "admin" {
				<div
					id="power-toggle"
					hx-get={ fmt.Sprintf("/partials/server/%s/power", server.ID) }
					hx-trigger="load"
					hx-swap="innerHTML"
				>
				</div>
			}
		</div>

		<div
			id="status-bar"
			hx-get={ fmt.Sprintf("/partials/server/%s/status", server.ID) }
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
			class="mb-6"
		>
			<div class="flex items-center gap-2 text-gray-400 text-sm">
				<span class="loading loading-dots loading-sm"></span>
			</div>
		</div>

		<div class="flex flex-wrap gap-2 mb-6 border-b border-base-300 pb-3" id="tab-strip">
			<button
				hx-get={ fmt.Sprintf("/partials/server/%s/commands", server.ID) }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				class={ tabClass(true) }
				id="tab-commands"
				onclick="document.querySelectorAll('#tab-strip button').forEach(b => b.className = 'btn btn-sm border border-base-300 hover:border-blue-400 transition-colors'); this.className = 'btn btn-sm border border-blue-400 bg-blue-500 bg-opacity-20 text-blue-300'"
			>
				Commands
			</button>
			if session.Role == "admin" {
				<button
					hx-get={ fmt.Sprintf("/partials/server/%s/manage", server.ID) }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					class={ tabClass(false) }
					id="tab-manage"
					onclick="document.querySelectorAll('#tab-strip button').forEach(b => b.className = 'btn btn-sm border border-base-300 hover:border-blue-400 transition-colors'); this.className = 'btn btn-sm border border-blue-400 bg-blue-500 bg-opacity-20 text-blue-300'"
				>
					Manage
				</button>
			}
		</div>

		<div id="tab-content" hx-get={ fmt.Sprintf("/partials/server/%s/commands", server.ID) } hx-trigger="load" hx-swap="innerHTML">
			<div class="flex items-center justify-center py-8">
				<span class="loading loading-dots loading-sm text-blue-400"></span>
			</div>
		</div>
	</div>
}

templ CommandsPartial(session *auth.Session, serverID string, templates []store.StoredTemplate) {
	<div class="flex gap-6">
		<div class="w-64 flex-shrink-0">
			if len(templates) == 0 {
				<p class="text-gray-400 text-sm py-4">No commands yet. Add some in the Manage tab.</p>
			} else {
				<div class="space-y-1" id="command-list">
					for _, t := range templates {
						<button
							hx-get={ fmt.Sprintf("/partials/server/%s/run/%d", serverID, t.ID) }
							hx-target="#command-detail"
							hx-swap="innerHTML"
							class="btn btn-sm btn-ghost w-full justify-start text-left border border-base-300 hover:border-blue-400 transition-colors"
							onclick="document.querySelectorAll('#command-list button').forEach(b => b.className = 'btn btn-sm btn-ghost w-full justify-start text-left border border-base-300 hover:border-blue-400 transition-colors'); this.className = 'btn btn-sm w-full justify-start text-left border border-blue-400 bg-blue-500 bg-opacity-20 text-blue-300'"
						>
							{ t.Name }
						</button>
					}
				</div>
			}
		</div>
		<div class="flex-1" id="command-detail">
			if len(templates) > 0 {
				<div class="flex items-center justify-center py-12 text-gray-400 text-sm">
					Select a command from the left.
				</div>
			}
		</div>
	</div>
}

templ CommandRunnerPartial(session *auth.Session, serverID string, template *store.StoredTemplate, params []config.TemplateParam) {
	<div class="card bg-base-200 bg-opacity-50 border border-base-300">
		<div class="card-body">
			<h4 class="card-title text-base text-white">{ template.Name }</h4>
			if template.Description != "" {
				<p class="text-sm text-gray-400">{ template.Description }</p>
			}
			<p class="text-xs font-mono text-gray-500 mt-1">{ template.Command }</p>

			<form
				hx-post={ fmt.Sprintf("/api/commands/%s", serverID) }
				hx-target="find .command-response"
				hx-swap="innerHTML"
				hx-disabled-elt="find button"
				class="space-y-3 mt-4"
			>
				<input type="hidden" name="command_template" value={ template.Command }/>
				for _, param := range params {
					@paramInput(serverID, param)
				}
				<div class="card-actions justify-end">
					<button type="submit" class="btn btn-primary btn-sm">Execute</button>
				</div>
				<div class="command-response mt-2"></div>
			</form>
		</div>
	</div>
}

templ paramInput(serverID string, param config.TemplateParam) {
	<div>
		<label class="label">
			<span class="label-text text-xs text-gray-300">{ param.Name }</span>
		</label>
		if param.Type == "player" {
			<select name={ param.Name } class="select select-bordered select-sm w-full text-sm"
				hx-get={ fmt.Sprintf("/partials/server/%s/players", serverID) }
				hx-trigger="load, every 10s"
				hx-swap="innerHTML"
			>
				<option value="">Loading players...</option>
			</select>
		} else if param.Type == "list" && len(param.Options) > 0 {
			<select name={ param.Name } class="select select-bordered select-sm w-full text-sm">
				for _, opt := range param.Options {
					<option value={ opt }>{ opt }</option>
				}
			</select>
		} else {
			<input type="text" name={ param.Name } placeholder={ param.Name } class="input input-bordered input-sm w-full text-sm"/>
		}
	</div>
}

templ StatusPartial(online bool, playerCount int, errorMsg string) {
	if online {
		<div class="inline-flex items-center gap-3 px-4 py-2 rounded-lg bg-green-900 bg-opacity-30 border border-green-600">
			<div class="w-2.5 h-2.5 bg-green-400 rounded-full"></div>
			<span class="text-sm font-semibold text-green-400">Online</span>
			<span class="text-sm text-gray-400">{ fmt.Sprintf("%d player(s)", playerCount) }</span>
		</div>
	} else {
		<div class="inline-flex items-center gap-3 px-4 py-2 rounded-lg bg-red-900 bg-opacity-30 border border-red-600">
			<div class="w-2.5 h-2.5 bg-red-400 rounded-full"></div>
			<span class="text-sm font-semibold text-red-400">Offline</span>
			if errorMsg != "" {
				<span class="text-xs text-gray-500">{ errorMsg }</span>
			}
		</div>
	}
}

templ LogPartial(logs []store.CommandLog) {
	if len(logs) == 0 {
		<p class="text-gray-500 text-sm py-4">No commands logged.</p>
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th class="text-xs text-gray-400">Time</th>
						<th class="text-xs text-gray-400">User</th>
						<th class="text-xs text-gray-400">Server</th>
						<th class="text-xs text-gray-400">Command</th>
						<th class="text-xs text-gray-400">Response</th>
					</tr>
				</thead>
				<tbody>
					for _, log := range logs {
						<tr class="hover">
							<td class="text-xs text-gray-400">{ log.Timestamp.Format(time.DateTime) }</td>
							<td class="text-xs text-gray-300">{ log.UserEmail }</td>
							<td class="text-xs text-gray-300">{ log.ServerID }</td>
							<td class="text-xs font-mono text-blue-300">{ log.Command }</td>
							<td class="text-xs font-mono text-gray-400 truncate max-w-xs">{ log.Response }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ CommandResponsePartial(status string, response string, errMsg string, durationMS int64) {
	if status == "executed" {
		<div class="text-xs font-mono p-3 rounded bg-green-900 bg-opacity-30 border border-green-600 text-green-300">
			✓ { response } <span class="text-gray-500">({ durationMS }ms)</span>
		</div>
	} else {
		<div class="text-xs font-mono p-3 rounded bg-red-900 bg-opacity-30 border border-red-600 text-red-300">
			✗ { errMsg }
		</div>
	}
}

templ PlayerOptionsPartial(players []string) {
	for _, p := range players {
		<option value={ p }>{ p }</option>
	}
}

templ PowerPartial(serverID string, desiredState string) {
	if desiredState == "running" {
		<div class="flex items-center gap-2">
			<span class="text-xs text-green-400 font-semibold">Desired: Running</span>
			<button
				hx-post={ fmt.Sprintf("/api/servers/%s/power", serverID) }
				hx-vals='{"state": "stopped"}'
				hx-target="#power-toggle"
				hx-swap="innerHTML"
				class="btn btn-sm btn-outline btn-error"
			>
				Stop Server
			</button>
		</div>
	} else {
		<div class="flex items-center gap-2">
			<span class="text-xs text-red-400 font-semibold">Desired: Stopped</span>
			<button
				hx-post={ fmt.Sprintf("/api/servers/%s/power", serverID) }
				hx-vals='{"state": "running"}'
				hx-target="#power-toggle"
				hx-swap="innerHTML"
				class="btn btn-sm btn-outline btn-success"
			>
				Start Server
			</button>
		</div>
	}
}

templ ManageCommandsPartial(session *auth.Session, serverID string, templates []store.StoredTemplate) {
	<div>
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-xl font-bold text-white">Manage Commands</h2>
			<button
				hx-get={ fmt.Sprintf("/partials/server/%s/template", serverID) }
				hx-target="#template-form"
				hx-swap="innerHTML"
				class="btn btn-primary btn-sm"
			>
				+ New Template
			</button>
		</div>
		<div id="template-form"></div>
		if len(templates) == 0 {
			<p class="text-gray-400 py-4">No command templates yet. Click "+ New Template" to create one.</p>
		} else {
			<div class="space-y-1">
				for _, t := range templates {
					<div class="template-row flex items-center justify-between bg-base-200 bg-opacity-50 rounded-lg px-4 py-2 border border-base-300">
						<div class="flex-1 min-w-0">
							<span class="text-sm font-medium text-white">{ t.Name }</span>
							<span class="text-xs text-gray-500 ml-2 font-mono truncate">{ t.Command }</span>
						</div>
						<div class="flex gap-1 flex-shrink-0">
							<button
								hx-get={ fmt.Sprintf("/partials/server/%s/template/%d", serverID, t.ID) }
								hx-target="#template-form"
								hx-swap="innerHTML"
								class="btn btn-ghost btn-xs"
							>
								Edit
							</button>
							<button
								hx-delete={ fmt.Sprintf("/api/templates/%d", t.ID) }
								hx-confirm="Delete this template?"
								hx-target="closest .template-row"
								hx-swap="delete"
								class="btn btn-ghost btn-xs text-red-400"
							>
								Delete
							</button>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ TemplateFormPartial(serverID string, template *store.StoredTemplate) {
	<div class="card bg-base-200 bg-opacity-50 border border-blue-400 mb-6">
		<div class="card-body" data-template-form data-server-id={ serverID } data-template-id={ templateIDStr(template) } data-params={ templateParamsJSON(template) }>
			<h3 class="card-title text-lg text-white">
				if template != nil {
					Edit Template
				} else {
					New Template
				}
			</h3>
			<form id="template-form-inner" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="label"><span class="label-text text-xs text-gray-300">Name</span></label>
						<input type="text" name="name" placeholder="e.g. Give Item" class="input input-bordered input-sm w-full"
							if template != nil { value={ template.Name } }
						/>
					</div>
					<div>
						<label class="label"><span class="label-text text-xs text-gray-300">Category</span></label>
						<input type="text" name="category" placeholder="e.g. Player Management" class="input input-bordered input-sm w-full"
							if template != nil { value={ template.Category } }
						/>
					</div>
				</div>
				<div>
					<label class="label"><span class="label-text text-xs text-gray-300">Description</span></label>
					<input type="text" name="description" placeholder="What this command does" class="input input-bordered input-sm w-full"
						if template != nil { value={ template.Description } }
					/>
				</div>
				<div>
					<label class="label"><span class="label-text text-xs text-gray-300">Command (use &#123;&#123;param&#125;&#125; for placeholders)</span></label>
					<input type="text" name="command" placeholder="e.g. give {{player}} {{item}} {{count}}" class="input input-bordered w-full font-mono text-sm"
						if template != nil { value={ template.Command } }
					/>
				</div>
				<div>
					<div class="flex items-center justify-between mb-2">
						<label class="label"><span class="label-text text-xs text-gray-300">Parameters</span></label>
						<button type="button" class="btn btn-ghost btn-xs" onclick="addParamRow()">+ Add Param</button>
					</div>
					<div id="param-list" class="space-y-2"></div>
				</div>
				<div class="card-actions justify-end gap-2">
					<button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('template-form').innerHTML=''">Cancel</button>
					<button type="button" class="btn btn-primary btn-sm" onclick="saveTemplate()">Save Template</button>
				</div>
			</form>
		</div>
	</div>
	<script>
		if (!window._templateState) {
			window._templateState = { counter: 0 };
		}
		var card = document.querySelector("[data-template-form]");
		var serverID = card.dataset.serverId;
		var templateID = card.dataset.templateId || null;
		window._templateState.counter = 0;

		// Pre-fill existing params if editing
		var existingParams = JSON.parse(card.dataset.params || "[]");
		existingParams.forEach(function(p) {
			var name = p.name || p.Name;
			var type = p.type || p.Type;
			var opts = (p.options || p.Options || []).join(",");
			addParamRow(name, type, opts);
		});

		function addParamRow(name, type, options) {
			const row = document.createElement("div");
			row.className = "flex items-center gap-2";
			row.dataset.param = window._templateState.counter++;
			row.innerHTML = `
				<input type="text" placeholder="param name" class="input input-bordered input-xs w-28" data-field="name" value="${name || ''}"/>
				<select class="select select-bordered select-xs" data-field="type" onchange="onTypeChange(this)">
					<option value="text">free text</option>
					<option value="list">from list</option>
					<option value="player">online player</option>
				</select>
				<input type="text" placeholder="options (comma-separated)" class="input input-bordered input-xs flex-1 hidden" data-field="options"/>
				<button type="button" class="btn btn-ghost btn-xs text-red-400" onclick="this.parentElement.remove()">✕</button>
			`;
			document.getElementById("param-list").appendChild(row);

			const typeSel = row.querySelector('[data-field="type"]');
			if (type) {
				typeSel.value = type;
				typeSel.dispatchEvent(new Event("change"));
			}
			const optsField = row.querySelector('[data-field="options"]');
			if (options) {
				optsField.value = options;
			}
		}

		function onTypeChange(sel) {
			const row = sel.parentElement;
			const optsField = row.querySelector('[data-field="options"]');
			optsField.classList.add("hidden");
			if (sel.value === "list") {
				optsField.classList.remove("hidden");
			}
		}

		function collectParams() {
			const params = [];
			document.querySelectorAll("#param-list > div").forEach(row => {
				const name = row.querySelector('[data-field="name"]').value;
				if (!name) return;
				const type = row.querySelector('[data-field="type"]').value;
				const param = { name, type };
				if (type === "list") {
					const opts = row.querySelector('[data-field="options"]').value;
					param.options = opts.split(",").map(s => s.trim()).filter(Boolean);
				}
				params.push(param);
			});
			return params;
		}

		function saveTemplate() {
			const form = document.getElementById("template-form-inner");
			const data = {
				name: form.querySelector('[name="name"]').value,
				category: form.querySelector('[name="category"]').value,
				description: form.querySelector('[name="description"]').value,
				command: form.querySelector('[name="command"]').value,
				params: collectParams(),
			};
			const url = templateID
				? "/api/templates/" + templateID
				: "/api/templates/" + serverID;
			const method = templateID ? "PUT" : "POST";
			fetch(url, {
				method,
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(data),
			}).then(r => {
				if (!r.ok) throw new Error("Save failed");
				document.getElementById("template-form").innerHTML = "";
				htmx.ajax("GET", "/partials/server/" + serverID + "/manage", { target: "#tab-content", swap: "innerHTML" });
			}).catch(err => alert(err.message));
		}
	</script>
}
